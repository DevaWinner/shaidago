{
  "schema_version": 1,
  "contract_id": "shaidago-controlled-vocabulary",
  "effective_date": "2026-09-19",
  "machine_value_pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
  "actors": [
    "system",
    "worker",
    "reviewer",
    "admin",
    "reporter"
  ],
  "vocabularies": {
    "project_category": {
      "kind": "classification",
      "values": [
        {"value": "health", "meaning": "Health facilities, equipment, or public-health services."},
        {"value": "education", "meaning": "Schools, learning facilities, equipment, or education services."},
        {"value": "water_sanitation", "meaning": "Water supply, drainage, toilets, waste, or sanitation works."},
        {"value": "roads_public_works", "meaning": "Roads, bridges, street infrastructure, or other public works."},
        {"value": "other_public_service", "meaning": "A sourced public service project that does not fit another category."}
      ],
      "change_policy": "reviewer_or_admin_reclassification_with_audit"
    },
    "project_public_status": {
      "kind": "state",
      "values": [
        {"value": "unknown", "meaning": "Approved evidence does not establish a current delivery state."},
        {"value": "planned", "meaning": "An approved source records an intention, allocation, or plan; procurement or physical delivery is not established."},
        {"value": "procurement", "meaning": "An approved source establishes an active tender, award, or contracting stage."},
        {"value": "in_progress", "meaning": "Approved evidence establishes that delivery work has started and is not recorded as complete."},
        {"value": "on_hold", "meaning": "An approved source explicitly states that delivery is paused, suspended, or stopped temporarily."},
        {"value": "completed", "meaning": "An approved source explicitly records completion; this does not independently prove quality or service availability."},
        {"value": "cancelled", "meaning": "An approved source explicitly records cancellation or permanent termination."}
      ],
      "initial_state": "unknown",
      "terminal_states": [],
      "change_policy": "reviewer_or_admin_with_approved_citation_and_append_only_update"
    },
    "information_class": {
      "kind": "classification",
      "values": [
        {"value": "official_source", "meaning": "Material published by a government institution or recognised public body."},
        {"value": "independent_source", "meaning": "Material published by a credible media, civic, research, or oversight organisation."},
        {"value": "community_evidence_reviewed", "meaning": "Community-submitted evidence assessed and approved for the stated public use."},
        {"value": "community_report_unverified", "meaning": "Private community information awaiting review; never public."},
        {"value": "ai_generated_explanation", "meaning": "A generated explanation grounded in citations; never an independent source."}
      ],
      "change_policy": "derived_from_source_and_review_context"
    },
    "source_type": {
      "kind": "classification",
      "values": [
        {"value": "government_publication", "meaning": "Government webpage, release, gazette, register, or administrative publication."},
        {"value": "budget_document", "meaning": "Government budget, appropriation, implementation, or expenditure document."},
        {"value": "procurement_record", "meaning": "Tender, award, contract, no-objection, or procurement register."},
        {"value": "audit_oversight_report", "meaning": "Audit, legislative, regulator, court, or formal oversight record."},
        {"value": "independent_media", "meaning": "Established news or specialist media reporting."},
        {"value": "civic_research", "meaning": "Recognised civil-society, academic, or research publication."},
        {"value": "community_evidence", "meaning": "Private community-supplied evidence eligible only after human review."},
        {"value": "other_public_source", "meaning": "A public source that does not fit another type; requires a reviewer note."}
      ],
      "change_policy": "reviewer_or_admin_classification_with_audit"
    },
    "source_review_state": {
      "kind": "state",
      "values": [
        {"value": "pending", "meaning": "The source has not been approved or rejected."},
        {"value": "in_review", "meaning": "A reviewer is assessing provenance, relevance, rights, and supporting passages."},
        {"value": "approved", "meaning": "A reviewer approved the source for its explicitly recorded scope."},
        {"value": "rejected", "meaning": "A reviewer rejected the source for use; the decision and reason remain auditable."},
        {"value": "superseded", "meaning": "A newer immutable source version replaces this version for current use."}
      ],
      "initial_state": "pending",
      "terminal_states": [],
      "change_policy": "state_machine"
    },
    "source_availability": {
      "kind": "state",
      "values": [
        {"value": "unchecked", "meaning": "No bounded availability check has completed."},
        {"value": "available", "meaning": "The source was retrievable at the recorded last-checked time."},
        {"value": "temporarily_unavailable", "meaning": "Retrieval failed in a way that may be transient."},
        {"value": "access_restricted", "meaning": "The source now requires access the platform must not bypass."},
        {"value": "permanently_unavailable", "meaning": "Repeated checks or an authoritative response establish that the source is no longer retrievable."}
      ],
      "initial_state": "unchecked",
      "terminal_states": [],
      "change_policy": "bounded_system_check_or_reviewer_confirmation"
    },
    "verification_state": {
      "kind": "state",
      "values": [
        {"value": "awaiting_verification", "meaning": "Evidence has not yet passed the applicable human verification rule."},
        {"value": "verified_official", "meaning": "The specific fact is directly supported by an approved official source passage."},
        {"value": "corroborated", "meaning": "The specific fact is supported by at least two approved, materially independent sources."},
        {"value": "community_reviewed", "meaning": "The specific community evidence was reviewed and approved for the stated use."},
        {"value": "disputed", "meaning": "Approved sources materially conflict and the conflict remains unresolved."},
        {"value": "outdated", "meaning": "The evidence is authentic but no longer adequate to describe the current position."}
      ],
      "initial_state": "awaiting_verification",
      "terminal_states": [],
      "change_policy": "reviewer_or_admin_with_citations_and_audit"
    },
    "report_concern_category": {
      "kind": "classification",
      "values": [
        {"value": "no_visible_work", "meaning": "The reporter did not observe expected work at the relevant public location."},
        {"value": "incomplete_work", "meaning": "The reporter observed work they believe is incomplete."},
        {"value": "unsafe_construction", "meaning": "The reporter observed a construction-related safety concern."},
        {"value": "suspected_incorrect_status", "meaning": "The reporter believes a published status may not match their observation."},
        {"value": "access_barrier", "meaning": "The reporter observed a barrier to using the promised public service."},
        {"value": "other_concern", "meaning": "A relevant concern that does not fit another category."}
      ],
      "change_policy": "reporter_selects_reviewer_may_reclassify_with_audit"
    },
    "report_risk_level": {
      "kind": "state",
      "values": [
        {"value": "standard", "meaning": "No elevated safety or sensitivity indicator has been recorded."},
        {"value": "elevated", "meaning": "The report needs priority or restricted handling because of a recorded safety or sensitivity factor."},
        {"value": "high", "meaning": "The report presents a serious recorded safety or sensitivity factor requiring the approved escalation guidance; ShaidaGo is not an emergency service."}
      ],
      "initial_state": "standard",
      "terminal_states": [],
      "change_policy": "system_may_flag_reviewer_or_admin_confirms_and_changes"
    },
    "report_status": {
      "kind": "state",
      "values": [
        {"value": "received", "meaning": "The private report was accepted and has not entered substantive review."},
        {"value": "needs_information", "meaning": "Review cannot proceed without a specific, safe follow-up answer."},
        {"value": "under_review", "meaning": "An authorised reviewer is assessing the report and evidence."},
        {"value": "verified_for_public_update", "meaning": "A reviewer found sufficient evidence to author a separate public-safe update; nothing is published automatically."},
        {"value": "referred", "meaning": "A reviewer recorded referral through an approved route without promising an external response."},
        {"value": "closed", "meaning": "No further internal review action is planned unless an authorised reviewer explicitly reopens the report."}
      ],
      "initial_state": "received",
      "terminal_states": [],
      "quiescent_states": ["closed"],
      "change_policy": "state_machine"
    },
    "evidence_sanitation_state": {
      "kind": "state",
      "values": [
        {"value": "pending", "meaning": "The upload is accepted into bounded temporary processing but is not available."},
        {"value": "processing", "meaning": "Type validation and metadata or active-content removal are running."},
        {"value": "sanitised", "meaning": "A safe derivative was produced; malware policy still applies separately."},
        {"value": "rejected", "meaning": "The upload violates the accepted file policy and no persistent artifact is created."},
        {"value": "failed", "meaning": "Sanitation could not complete safely and no artifact is available."}
      ],
      "initial_state": "pending",
      "terminal_states": ["sanitised", "rejected", "failed"],
      "change_policy": "state_machine"
    },
    "malware_scan_state": {
      "kind": "state",
      "values": [
        {"value": "pending", "meaning": "The sanitised artifact is waiting for the configured scan policy."},
        {"value": "scanning", "meaning": "The configured scanner is processing the sanitised artifact."},
        {"value": "clean", "meaning": "The configured scanner found no known malware in the scanned artifact."},
        {"value": "malware_detected", "meaning": "The scanner detected malware; the artifact is never made available."},
        {"value": "scan_failed", "meaning": "The required scan did not complete; the artifact remains unavailable."},
        {"value": "not_scanned_demo", "meaning": "The hosted fictional-data demo intentionally has no scanner; this mode is forbidden in production and is visible to reviewers."}
      ],
      "initial_state": "pending",
      "terminal_states": ["clean", "malware_detected", "scan_failed", "not_scanned_demo"],
      "change_policy": "state_machine"
    },
    "discovery_status": {
      "kind": "state",
      "values": [
        {"value": "queued", "meaning": "The run is durable and waiting for worker capacity."},
        {"value": "searching", "meaning": "The worker is finding and safely fetching permitted public sources."},
        {"value": "analysing", "meaning": "Retrieved inert passages are being deduplicated and analysed."},
        {"value": "needs_review", "meaning": "Automated validation or a safety rule requires reviewer action before completion."},
        {"value": "complete", "meaning": "The run completed; each result remains discovered and unverified until separately reviewed."},
        {"value": "failed", "meaning": "Bounded retries were exhausted or a non-retryable failure occurred."},
        {"value": "cancelled", "meaning": "An authorised actor stopped future work; already retrieved results remain reviewable."}
      ],
      "initial_state": "queued",
      "terminal_states": ["complete", "failed", "cancelled"],
      "change_policy": "state_machine"
    },
    "discovered_source_disposition": {
      "kind": "state",
      "values": [
        {"value": "not_reviewed", "meaning": "No reviewer decision has been recorded."},
        {"value": "attached", "meaning": "A reviewer attached the source to the approved source workflow; fact approval remains separate."},
        {"value": "rejected", "meaning": "A reviewer rejected the source with an auditable reason."},
        {"value": "deferred", "meaning": "A reviewer postponed a final decision and recorded what remains unresolved."}
      ],
      "initial_state": "not_reviewed",
      "terminal_states": [],
      "change_policy": "state_machine"
    },
    "translation_status": {
      "kind": "state",
      "values": [
        {"value": "reviewed", "meaning": "A fluent human reviewer approved the translation for this version."},
        {"value": "machine_assisted", "meaning": "Automation helped produce the text and fluent human approval is not recorded."},
        {"value": "unavailable", "meaning": "No translation is available; the UI must label any source-locale fallback honestly."}
      ],
      "initial_state": "unavailable",
      "terminal_states": [],
      "change_policy": "translation_review_workflow"
    }
  },
