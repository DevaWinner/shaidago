      "failure_code": "source_review_transition_not_allowed",
      "transitions": [
        {"from": "pending", "command": "start_review", "actors": ["reviewer", "admin"], "to": "in_review", "audit_event": "source_review_started", "public_visibility": "none"},
        {"from": "in_review", "command": "approve", "actors": ["reviewer", "admin"], "to": "approved", "audit_event": "source_approved", "public_visibility": "eligible_after_fact_publication"},
        {"from": "in_review", "command": "reject", "actors": ["reviewer", "admin"], "to": "rejected", "audit_event": "source_rejected", "public_visibility": "none"},
        {"from": "approved", "command": "reopen_review", "actors": ["reviewer", "admin"], "to": "in_review", "audit_event": "source_review_reopened", "public_visibility": "none"},
        {"from": "approved", "command": "supersede", "actors": ["reviewer", "admin"], "to": "superseded", "audit_event": "source_superseded", "public_visibility": "historical_only"},
