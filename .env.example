# ShaidaGo environment template. Copy to .env (never commit .env).
# Every value below is a placeholder. Values containing "change-me" (or keys that decode to it)
# are accepted only when APP_ENV is development or test; staging and production refuse them.
# Generate real 32-byte keys with: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"

# --- Application (BE-020) ---
# development | test | staging | production
APP_ENV=development
SERVICE_NAME=shaidago-platform
# Refused in staging and production.
DEBUG=false
# OpenAPI docs endpoints. Refused in staging and production.
DOCS_ENABLED=true
LOG_LEVEL=INFO
# Upper bound for each dependency probe behind /health/ready.
READINESS_CHECK_TIMEOUT_SECONDS=2

# --- Database: PostgreSQL 18, psycopg 3 driver ---
DATABASE_URL=postgresql+psycopg://shaidago:change-me-database@localhost:55432/shaidago
# Migration owner: used by `make migrate` and tools, never by the running API.
# The API connects as the public role below (created by the baseline, enabled by `make db-roles`).
DATABASE_URL_PUBLIC=postgresql+psycopg://shaidago_public:change-me-public-role-password@localhost:55432/shaidago
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Server-side cap on any single statement.
DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- Local infrastructure containers (infra/docker/compose.yml; make infra-up) ---
# Bootstrap values for the containers. Application roles are created by migrations (BE-032).
POSTGRES_USER=shaidago
POSTGRES_PASSWORD=change-me-database
POSTGRES_DB=shaidago
REDIS_PASSWORD=change-me-redis
# Host ports, published only on this address. Do not change it to expose the services.
INFRA_BIND_ADDRESS=127.0.0.1
INFRA_POSTGRES_PORT=55432
INFRA_REDIS_PORT=56379
INFRA_MINIO_PORT=59000
INFRA_MINIO_CONSOLE_PORT=59001
INFRA_CLAMD_PORT=53310
# The scanner needs roughly 1.5-3 GB of memory.
INFRA_CLAMAV_MEM_LIMIT=2560m

# Application-role login passwords, applied by `make db-roles` after `make migrate`.
# At least 16 characters; refused in staging and production while they contain "change-me".
DB_PASSWORD_PUBLIC=change-me-public-role-password
DB_PASSWORD_REVIEWER=change-me-reviewer-role-password
DB_PASSWORD_WORKER=change-me-worker-role-password
DB_PASSWORD_READONLY_OPS=change-me-readonly-ops-password

# --- Redis: jobs and shared rate limits ---
REDIS_URL=redis://:change-me-redis@localhost:56379/0

# --- Private evidence object storage (MinIO locally, R2 hosted) ---
OBJECT_STORE_ENDPOINT_URL=http://localhost:59000
OBJECT_STORE_BUCKET=shaidago-evidence-dev
OBJECT_STORE_ACCESS_KEY_ID=change-me-access-key
OBJECT_STORE_SECRET_ACCESS_KEY=change-me-secret-key
# Evidence buckets must stay private; true is refused in staging and production.
OBJECT_STORE_BUCKET_IS_PUBLIC=false
# clamd | not_deployed. not_deployed is for the hosted demo only and is refused in production.
SCANNER_MODE=clamd

# --- Encryption keys (ADR-0004) and HMAC peppers (ADR-0005): 32 random bytes, base64 ---
# Key rings are version=key pairs, comma separated; the active version must be in the ring.
ENCRYPTION_KEKS=kek-dev-1=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtMzI=
ENCRYPTION_ACTIVE_KEK_VERSION=kek-dev-1
TRACKING_PEPPERS=pepper-dev-1=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtMzI=
TRACKING_ACTIVE_PEPPER_VERSION=pepper-dev-1
IDEMPOTENCY_PEPPER=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtMzI=
# Signs pagination cursors so they cannot be forged or replayed across filters.
CURSOR_HMAC_KEY=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtMzI=

# --- Authentication ---
# First reviewer, created by `make reviewer-bootstrap`. The password is refused in staging and
# production while it contains a placeholder marker; the command never overwrites an existing user.
REVIEWER_BOOTSTRAP_IDENTIFIER=demo-reviewer
REVIEWER_BOOTSTRAP_PASSWORD=change-me-reviewer-bootstrap
REVIEWER_BOOTSTRAP_ROLE=reviewer
# BFF-to-API bearer secret (ADR-0002), at least 32 characters. Server-side only; never NEXT_PUBLIC_*.
INTERNAL_WEB_CREDENTIAL_CURRENT=change-me-internal-web-credential-000000
# Set only while rotating; must differ from the current value.
INTERNAL_WEB_CREDENTIAL_PREVIOUS=
SESSION_HMAC_KEY=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtMzI=
# Staging and production require __Host-sg_session with SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_NAME=sg_session
SESSION_COOKIE_SECURE=false

# --- Providers (ADR-0008) ---
# replay (fixtures, default) | live. Production requires live, which needs both keys below.
PROVIDER_MODE=replay
OPENAI_API_KEY=
SEARCH_API_KEY=
OPENAI_QA_MODEL=gpt-5.6-terra
OPENAI_DISCOVERY_MODEL=gpt-6-astra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Global daily cap on public Source Scout runs.
DISCOVERY_PUBLIC_DAILY_RUNS=20

# --- Rate limits (requests per window per pseudonymous client) ---
RATE_SIGN_IN_PER_15M=10
RATE_SUBMISSION_PER_HOUR=10
RATE_TRACKING_LOOKUP_PER_HOUR=20
RATE_HANDLE_VERIFY_PER_HOUR=10
RATE_QA_PER_HOUR=30
RATE_DISCOVERY_PER_HOUR=5
