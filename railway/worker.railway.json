{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/platform/Dockerfile"
  },
  "deploy": {
    "startCommand": "dramatiq shaidago.worker.entry --queues discovery --processes 1 --threads 2",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "drainingSeconds": 30
  }
}
